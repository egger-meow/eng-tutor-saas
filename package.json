{
  "name": "eng-tutor-saas",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @paper-english/web dev",
    "lint": "pnpm --filter @paper-english/web lint",
    "test": "vitest run --exclude **/dist/**",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "generate:synthetic": "pnpm --filter @paper-english/pdf generate:synthetic",
    "generate:public-sample": "pnpm --filter @paper-english/pdf generate:public-sample",
    "audit:curriculum": "pnpm --filter @paper-english/generator audit:curriculum --",
    "compile:bundle": "pnpm --filter @paper-english/generator compile:bundle",
    "admin": "pnpm --filter @paper-english/admin dev",
    "admin:build": "pnpm --filter @paper-english/admin build",
    "admin:start": "pnpm --filter @paper-english/admin start",
    "worker": "pnpm --filter @paper-english/worker worker",
    "production-authoring": "pnpm --filter @paper-english/worker worker production-authoring",
    "history-exams": "tsx scripts/history-exams/src/cli.ts"
  },
  "devDependencies": {
    "pdfjs-dist": "5.4.149",
    "playwright": "^1.61.0",
    "supabase": "^2.48.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18",
    "zod": "^4.0.1"
  }
}
