{
  "name": "eng-tutor-saas",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @paper-english/web dev",
    "lint": "pnpm --filter @paper-english/web lint",
    "test": "vitest run --exclude **/dist/**",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "generate:synthetic": "pnpm --filter @paper-english/pdf generate:synthetic",
    "worker": "pnpm --filter @paper-english/worker worker"
  },
  "devDependencies": {
    "supabase": "^2.48.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}
