# Browser-safe values only. Never prefix worker secrets with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Scheduled worker only. Never expose these values through VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
SITE_URL=https://paperbond.jjmowlab.com
RESEND_API_KEY=re_your-server-only-key
EMAIL_FROM=紙屬英文 <noreply@paperenglish.com>
# At least 32 random characters. Rotating it revokes all outstanding material links.
MATERIAL_LINK_SECRET=replace-with-a-long-random-server-only-secret

# Paddle Sandbox. The API key, webhook secret, and API base URL are server-only and must never use VITE_*.
# Sandbox uses PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
# Production uses PADDLE_API_BASE_URL=https://api.paddle.com
VITE_PADDLE_CLIENT_TOKEN=test_your-client-side-token
VITE_PADDLE_ENV=sandbox
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=pdl_sdbx_apikey_your-server-only-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-webhook-secret
