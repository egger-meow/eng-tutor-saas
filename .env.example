# Browser-safe values only. Never prefix worker secrets with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Use /eng-tutor-saas/ for project GitHub Pages or / for a custom domain.
VITE_BASE_PATH=/

# Scheduled worker only. Never expose these values through VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
