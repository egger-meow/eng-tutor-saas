    "instruction": [
      {
        "id": "ins-be-verb",
        "titleZh": "be 動詞 is 與 are",
        "explanationZh": "單數主詞（如 he, she, it, one block）用 is；複數主詞（如 they, we, two doors）用 are。",
        "patterns": [
          "單數主詞 + is + 形容詞/名詞",
          "複數主詞 + are + 形容詞/名詞"
        ],
        "workedExamples": [
          {
            "example": "The redstone block is red.",
            "walkthroughZh": "主詞是單數的一塊紅石，所以用 is。"
          },
          {
            "example": "Two iron doors are strong.",
            "walkthroughZh": "主詞是複數的兩扇門，所以用 are。"
          }
        ],
        "commonMistakes": [
          {
            "wrong": "The block are red.",
            "corrected": "The block is red.",
            "whyZh": "單數主詞不能用 are。"
          }
        ]
      }
    ],
